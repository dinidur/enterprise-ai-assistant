# Copy this file to .env and fill in real values. Never commit .env.

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO

# --- LLM (Gemini free tier - https://aistudio.google.com/apikey) ---
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.6-flash
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_TEMPERATURE=0.0

# --- Embeddings (local, free, no quota) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# --- Vector database (Pinecone) ---
PINECONE_API_KEY=
PINECONE_INDEX=enterprise-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Observability (LangSmith) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=enterprise-ai-assistant

# --- Rate limiting (token bucket) ---
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_SECOND=0.5

# --- Retrieval tuning ---
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=20
